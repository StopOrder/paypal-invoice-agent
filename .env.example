# PayPal sandbox app — developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# Google AI Studio key — aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# 1 = never call the AI; return a canned draft (default for local dev and tests)
MOCK_AI=1

# Optional daily caps that protect the free AI quota
EXTRACT_DAILY_LIMIT=5
EXTRACT_GLOBAL_DAILY_LIMIT=150
