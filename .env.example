# PayPal sandbox app — developer.paypal.com > Apps & Credentials > Sandbox
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=

# AI provider, option 1: any OpenAI-compatible endpoint with a vision model (used when all three are set)
AI_BASE_URL=
AI_API_KEY=
AI_MODEL=

# AI provider, option 2: Google AI Studio key — aistudio.google.com
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.8-flash

# 1 = never call the AI; return a canned draft (default for local dev and tests)
MOCK_AI=1

# Optional daily caps that protect the free AI quota
EXTRACT_DAILY_LIMIT=5
EXTRACT_GLOBAL_DAILY_LIMIT=150
